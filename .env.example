# API
PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Seed admin pertama saat API start (hanya kalau belum ada).
# PENTING: jangan pakai nilai contoh di bawah untuk production.
# Di production, password lemah/umum akan membuat server GAGAL start (fail-fast).
# Bikin password acak: openssl rand -base64 24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Set true HANYA kalau mau memaksa reset password admin yang sudah ada.
ADMIN_PASSWORD_RESET=false

# Kunci untuk registrasi admin lewat website.
# WAJIB diganti, minimal 16 karakter, dan BUKAN nilai contoh. Kalau masih nilai
# contoh / terlalu pendek, endpoint /api/auth/admin-register akan menolak (503).
ADMIN_INVITE_KEY=change-this-invite-key

# Shortcut pembayaran khusus development. TIDAK PERNAH aktif di production.
# Kalau kosong, masih 'local-only', atau < 12 karakter, endpoint mock-payment mati.
DEV_PAYMENT_KEY=local-only

# Placeholder integrasi payment production
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret

# API
PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Seeds the first admin account on API startup when it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Required for website-based admin registration
ADMIN_INVITE_KEY=change-this-invite-key

# Development-only payment shortcut; never use a real production secret here
DEV_PAYMENT_KEY=local-only

# Production payment integration placeholder
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
